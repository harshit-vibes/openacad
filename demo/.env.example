# LLM provider — openrouter (recommended) | anthropic | openai | deepseek
LLM_PROVIDER=openrouter

# OpenRouter (one key, hundreds of models, OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap defaults: Grok 4 Fast is ~$0.20/1M in, $0.50/1M out and supports tool calling.
# Other cheap alternatives:
#   google/gemini-2.5-flash-lite       (~$0.075/1M in, $0.30/1M out)
#   meta-llama/llama-3.3-70b-instruct  (~$0.05/1M in, $0.20/1M out via DeepInfra)
#   deepseek/deepseek-chat-v3.1        (~$0.20/1M in, $0.80/1M out)
#   anthropic/claude-haiku-4.5         (cleaner tool calling; pricier)
OPENROUTER_EXTRACTION_MODEL=x-ai/grok-4-fast
OPENROUTER_SYNTHESIS_MODEL=x-ai/grok-4-fast

# Anthropic (direct, alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-4-6

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o

# DeepSeek (alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding model (local, no API)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths (defaults — usually no need to override)
VAULT_DIR=./vault
DATA_DIR=./data
EMBEDDINGS_DIR=./data/embeddings
TINYDB_PATH=./data/state.json

# Thresholds
PROMPT_REGEN_THRESHOLD=10
REGISTRY_PROMOTE_THRESHOLD=3

# Server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
